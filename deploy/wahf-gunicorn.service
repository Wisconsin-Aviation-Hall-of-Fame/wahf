[Unit]
Description=Gunicorn daemon for wahf.org
After=network.target

[Service]
User=wahf
Group=wahf
WorkingDirectory=/home/wahf/wahf.org
EnvironmentFile=/home/wahf/wahf.org/.env
ExecStart=/home/wahf/production/.direnv/python-3.14/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    wahf.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
